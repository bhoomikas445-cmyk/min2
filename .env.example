# PALIMPSEST Environment Configuration
# Copy this file to .env to configure your local environment

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=palimpsest-super-secret-dev-key-change-in-production

# Database Configuration (defaults to instance/palimpsest.db)
DATABASE_URI=sqlite:///instance/palimpsest.db

# LLM Provider Configuration ("openai", "anthropic", or "rule_based")
# If no API key is provided, PALIMPSEST automatically operates in deterministic rule-based fallback mode.
LLM_PROVIDER=rule_based
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

# Token Budget and Memory Thresholds
DEFAULT_TOKEN_BUDGET=2048
VERBATIM_THRESHOLD=0.75
DISCARD_THRESHOLD=0.30

# Fallback Flag (set to true to force deterministic rule-based engine even if API keys are set)
FORCE_FALLBACK=false
